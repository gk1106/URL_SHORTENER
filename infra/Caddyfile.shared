{
    auto_https off
    admin off
}

# Private HTTP gateway behind the VPS's existing HTTPS reverse proxy.
# Compose publishes this listener on host loopback only.
:80 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    @admin path /auth/admin* /auth/realms/master*
    respond @admin 403
    redir /auth /auth/ 308
    handle /auth/* {
        reverse_proxy keycloak:8080 {
            # Public access MUST terminate HTTPS at the outer proxy.
            # Do not let this HTTP hop make Keycloak generate HTTP URLs.
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Port 443
        }
    }
    handle /r/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:8080
    }
}
