# Copy to .env.server on your server. Replace every password and SMTP value.
PUBLIC_ORIGIN=https://link.gkbuilds.in
ACME_EMAIL=you@gkbuilds.in
KEYCLOAK_ADMIN_USERNAME=gkgo-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-password
ORACLE_PASSWORD=replace-with-a-different-long-random-password
DB_PASSWORD=replace-with-a-different-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_FROM=accounts@gkbuilds.in
SMTP_FROM_NAME=GK GO
SMTP_USERNAME=accounts@gkbuilds.in
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_STARTTLS=true
SMTP_SSL=false
